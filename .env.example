# SentinelBrief — environment template. Copy to .env and fill in real values.
# Real .env files are gitignored; only this file is tracked. Never commit secrets.
#
# Every variable core/config.py::Settings reads is documented here; a test
# (tests/test_env_example_roster.py, since M1 task-00) fails if a Settings field is missing from this
# file. Variables marked "(from Mn)" are read only once that milestone lands — leave them at
# their defaults until then.

# ---------------------------------------------------------------------------------------------
# LLM (M0)
# ---------------------------------------------------------------------------------------------
# API key for the OpenAI-compatible endpoint below. SECRET.
LLM_API_KEY=
# Any OpenAI-compatible base URL. OpenAI by default; NVIDIA NIM (free keys at build.nvidia.com):
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_BASE_URL=https://api.openai.com/v1
# Structured-output mechanism. "json_object" (default) works on every OpenAI-compatible endpoint
# because the verdict JSON schema is embedded in the prompt; "json_schema" opts into strict
# schema mode on endpoints that support it.
LLM_JSON_MODE=json_object
# Model ids for the two routing tiers (PRD §6.4). Never hardcoded in code; both must be priced
# in MODEL_PRICES_JSON or the API/worker refuse to boot. STRONG_MODEL may stay empty until M5.
CHEAP_MODEL=
STRONG_MODEL=
# USD per million tokens, per model id, as one JSON object. SINGLE-QUOTE the whole value —
# dotenv parsers (uv --env-file, docker compose env_file) strip unquoted inner double quotes and
# the JSON becomes invalid. Example:
#   MODEL_PRICES_JSON='{"gpt-4o-mini":{"input_per_mtok":"0.15","output_per_mtok":"0.60"}}'
# A free-tier model is priced explicitly at 0, never left out.
MODEL_PRICES_JSON='{}'
# Active prompt version — a file under worker/prompts/ (PRD §6; CONVENTIONS.md §13).
TRIAGE_PROMPT_VERSION=triage-v1

# ---------------------------------------------------------------------------------------------
# Routing, tool loop, budget (from M4/M5/M8)
# ---------------------------------------------------------------------------------------------
# Escalate to STRONG_MODEL when the cheap verdict's severity >= this ... (PRD §6.4, from M5)
ESCALATE_SEVERITY_GTE=4
# ... or its confidence < this (from M5)
ESCALATE_CONFIDENCE_LT=0.6
# Hard cap on tool-call iterations per alert before a verdict is forced (PRD §6.3, from M4)
TOOL_LOOP_MAX_ITER=6
# Daily token budget across all LLM calls; 0 = unlimited. When exceeded, alerts stay `pending`
# and the dashboard shows a banner (PRD §10.3, from M8).
DAILY_TOKEN_BUDGET=0

# ---------------------------------------------------------------------------------------------
# Persistence (from M2), queue (from M5)
# ---------------------------------------------------------------------------------------------
# Postgres DSN. SECRET (embeds the password). Dev default targets the compose `postgres` service
# by its service name — containers reach each other over the compose network, not localhost.
DATABASE_URL=postgresql://sentinel:sentinel@postgres:5432/sentinelbrief
# Redis for the ARQ queue, verdict pub/sub, rate-limit counters, tool caches (from M5).
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------------------------
# Ingest & admin auth (from M2 / M8)
# ---------------------------------------------------------------------------------------------
# Shared secret for the shipper's HMAC signature over the request body (PRD §6.1). SECRET.
# Required in every environment. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
INGEST_HMAC_SECRET=
# Bearer token for POST /api/v1/alerts/{id}/retriage (PRD §8, from M8). SECRET. Generate as above.
ADMIN_TOKEN=
# Global retriage cap per UTC day, tracked in Redis (PRD §8, from M8)
RETRIAGE_PER_DAY=20
# Per-IP request cap on public GET endpoints, sliding one-minute window, in-app with Redis
# counters (PRD §8, from M8)
PUBLIC_RATE_LIMIT_PER_MIN=60

# ---------------------------------------------------------------------------------------------
# Enrichment tools (from M4)
# ---------------------------------------------------------------------------------------------
# AbuseIPDB key. SECRET, optional: empty → lookup_ip_reputation returns {"unavailable": true}.
ABUSEIPDB_API_KEY=
# MaxMind license key. SECRET, deploy-time only: used to download the GeoLite2 .mmdb into a
# volume. The .mmdb is never committed. Empty → get_ip_geo_asn returns {"unavailable": true}.
MAXMIND_LICENSE_KEY=
# Path to the downloaded GeoLite2 City database inside the worker container. Empty → unavailable.
GEOIP_DB_PATH=
# Static fleet description for get_asset_info (PRD §6.3)
ASSETS_YAML_PATH=honeypot/assets.yaml
# Character budget every tool result is truncated to before it is fed back to the model (PRD
# §6.3). One backstop for every tool, not a per-tool setting.
TOOL_RESULT_MAX_CHARS=4000

# ---------------------------------------------------------------------------------------------
# API / web (from M2 / M3)
# ---------------------------------------------------------------------------------------------
# Comma-separated allowed CORS origins — the dashboard's origin(s). No wildcard in deployed envs.
CORS_ORIGINS=http://localhost:3000
# "development" (default) or "production". Production turns on the boot-time guards for every
# required secret and the stricter response headers.
ENVIRONMENT=development
# Browser-visible API origin, inlined into the web bundle at `next build` (BUILD-time; changing
# it means a rebuild). Read by the SSE hook (from M3/M8).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only API origin the web container uses for server-side rendering — the compose-network
# service name, not localhost. Needed at build time AND runtime (from M3).
API_URL=http://api:8000
# How long GET /api/v1/alerts list responses are served from the in-process cache (PRD §8).
ALERTS_LIST_CACHE_TTL_S=15
# How long GET /api/v1/stats responses are served from the in-process cache (PRD §8).
STATS_CACHE_TTL_S=60
# Max entries the in-process list/stats cache holds before evicting (M5's Redis backend uses its
# own maxmemory instead).
ALERTS_CACHE_MAX_ENTRIES=1024

# ---------------------------------------------------------------------------------------------
# Dev/test only — never set on a deployed service
# ---------------------------------------------------------------------------------------------
# Throwaway-schema Postgres URL for the test suite (CONVENTIONS.md §10, from M2). Point it at a
# DEDICATED database (…/sentinelbrief_test), never the dev database. When unset, DB tests are
# skipped (recorded as skips, never as passes) — pytest output without it is not gate evidence.
# TEST_DATABASE_URL=postgresql://sentinel:sentinel@127.0.0.1:5434/sentinelbrief_test
