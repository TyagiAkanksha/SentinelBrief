# Build context is the repo root (infra/docker-compose.yml sets `context: ..`,
# `dockerfile: infra/Dockerfile.api`). Runtime config is env-only — no `.env` is ever baked in.
# Migrations never run at container start; run them explicitly:
#   docker compose -f infra/docker-compose.yml run --rm api uv run alembic upgrade head

# ---------- Stage 1: resolve the uv project into a venv ----------
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1

WORKDIR /app

# Manifests first (layer-cached until a dependency changes).
COPY pyproject.toml uv.lock ./

# Third-party dependencies only — no application source copied yet.
RUN uv sync --frozen --no-dev --no-install-project

# The sources the runtime image needs.
COPY api ./api
COPY worker ./worker
COPY core ./core
COPY evals ./evals
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini

# Install the project itself. `uv sync` here installs the project editable against /app, so the
# runtime stage must copy the venv AND the sources it points at (see the COPY lines below).
RUN uv sync --frozen --no-dev

# ---------- Stage 2: runtime ----------
FROM python:3.12-slim-bookworm

RUN useradd --create-home --uid 1001 appuser

WORKDIR /app
COPY --from=builder --chown=appuser:appuser /app/.venv /app/.venv
COPY --from=builder --chown=appuser:appuser /app/api ./api
COPY --from=builder --chown=appuser:appuser /app/worker ./worker
COPY --from=builder --chown=appuser:appuser /app/core ./core
COPY --from=builder --chown=appuser:appuser /app/evals ./evals
COPY --from=builder --chown=appuser:appuser /app/alembic ./alembic
COPY --from=builder --chown=appuser:appuser /app/alembic.ini ./alembic.ini
# The `uv` binary itself (not just the venv it built) so the README-documented migration
# invocation (`uv run alembic upgrade head`) works in the runtime image too.
COPY --from=builder /usr/local/bin/uv /usr/local/bin/uv
ENV PATH="/app/.venv/bin:$PATH"

USER appuser
EXPOSE 8000

# urlopen raises on any non-2xx/connection failure -> non-zero exit (CONVENTIONS.md §11:
# stdlib-only HEALTHCHECK, no curl/wget in the image).
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=4)"]

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
