            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "source": {
            "const": "cowrie",
            "title": "Source",
            "type": "string"
          },
          "src_ip": {
            "title": "Src Ip",
            "type": "string"
          }
        },
        "required": [
          "source",
          "session_id",
          "src_ip",
          "sensor",
          "events"
        ],
