{
  "components": {
    "schemas": {
      "AlertDetail": {
        "description": "The single-alert view (PRD \u00a78): full raw payload, latest verdict, and its tool calls.",
        "properties": {
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "event_time": {
            "format": "date-time",
            "title": "Event Time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "raw": {
            "additionalProperties": true,
            "title": "Raw",
            "type": "object"
          },
          "received_at": {
            "format": "date-time",
            "title": "Received At",
            "type": "string"
          },
          "sensor": {
            "title": "Sensor",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "src_ip": {
            "title": "Src Ip",
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "triaged",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "tool_calls": {
            "items": {
              "$ref": "#/components/schemas/ToolCallOut"
            },
            "title": "Tool Calls",
            "type": "array"
          },
          "verdict": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VerdictOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "source",
          "src_ip",
          "sensor",
          "event_time",
          "received_at",
          "status",
          "raw",
          "verdict",
          "tool_calls"
        ],
        "title": "AlertDetail",
        "type": "object"
      },
      "AlertSummary": {
        "description": "One list row (PRD \u00a78): the latest verdict's summary, or `None` for pending/failed alerts.",
        "properties": {
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "event_time": {
            "format": "date-time",
            "title": "Event Time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "received_at": {
            "format": "date-time",
            "title": "Received At",
            "type": "string"
          },
          "sensor": {
            "title": "Sensor",
